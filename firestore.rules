rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isFounder() {
      return request.auth != null && (
        request.auth.token.role == 'FOUNDER' ||
        request.auth.token.admin == true ||
        request.auth.token.email == 'ronaldomazive915@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUser().role == 'FOUNDER')
      );
    }

    // Granular authorization: SER ADMIN NÃO SIGNIFICA TER TODAS AS PERMISSÕES.
    // Founder has full access; Admin must have the specific permission == true.
    function hasPermission(permKey) {
      return isFounder() || (
        request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUser().role == 'ADMIN' &&
        getUser().permissions[permKey] == true
      );
    }

    // Public catalog (Movies, Series, Episodes, Live Channels)
    match /catalog/{document=**} {
      allow read: if true;
      allow create, update: if hasPermission('catalog') || hasPermission('importFilme') || hasPermission('importSerie');
      allow delete: if hasPermission('deleteContent');
    }

    match /deleted_catalog/{document=**} {
      allow read: if true;
      allow create, update, delete: if hasPermission('deleteContent') || isFounder();
    }

    match /media/{document=**} {
      allow read: if true;
      allow create, update: if hasPermission('catalog') || hasPermission('importFilme') || hasPermission('importSerie');
      allow delete: if hasPermission('deleteContent');
    }

    match /episodes/{document=**} {
      allow read: if true;
      allow create, update: if hasPermission('catalog') || hasPermission('importSerie');
      allow delete: if hasPermission('deleteContent');
    }

    match /live_channels/{document=**} {
      allow read: if true;
      allow write: if hasPermission('tvAoVivo');
    }

    match /channels/{document=**} {
      allow read: if true;
      allow write: if hasPermission('tvAoVivo');
    }

    match /events/{document=**} {
      allow read: if true;
      allow write: if hasPermission('tvAoVivo') || isFounder();
    }

    match /featured/{document=**} {
      allow read: if true;
      allow write: if hasPermission('destaques') || hasPermission('top10');
    }

    match /notifications/{document=**} {
      allow read: if true;
      allow write: if hasPermission('notificacoes');
    }

    match /notificationEvents/{document=**} {
      allow read: if true;
      allow write: if hasPermission('notificacoes');
    }

    match /catalog_metadata/{document=**} {
      allow read: if true;
      allow write: if hasPermission('catalog') || hasPermission('sincronizarCatalogo');
    }

    match /media_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if hasPermission('pedidosTmdb');
    }

    match /devices/{deviceId} {
      allow read: if true;
      allow write: if true; // Devices register themselves
    }

    match /import_jobs/{jobId} {
      allow read: if true;
      allow write: if hasPermission('importFilme') || hasPermission('importSerie') || hasPermission('importacaoMassa');
    }

    match /import_items/{itemId} {
      allow read: if true;
      allow write: if hasPermission('importFilme') || hasPermission('importSerie') || hasPermission('importacaoMassa');
    }

    // Player Sources & Configurations
    match /playerSources/{document=**} {
      allow read: if true;
      allow write: if hasPermission('players') || hasPermission('configurarPlayers');
    }

    match /playerConfig/{document=**} {
      allow read: if true;
      allow write: if hasPermission('configurarPlayers') || hasPermission('players');
    }

    // App Settings & Live Configuration
    match /config/{document=**} {
      allow read: if true;
      allow write: if hasPermission('configuracoes') || hasPermission('configurarPlayers');
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if hasPermission('configuracoes') || hasPermission('configurarPlayers');
    }

    // User profiles & Administration
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || hasPermission('users') || hasPermission('administrators') || hasPermission('administradores');
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if (request.auth != null && request.auth.uid == uid) || hasPermission('manageAdmins') || hasPermission('managePermissions') || hasPermission('users');
      allow delete: if hasPermission('deleteUsers');

      match /profiles/{profileId} {
        allow read: if request.auth != null;
        
        // Prevent ordinary users from setting isVerified to true on creation
        allow create: if request.auth != null && request.auth.uid == uid 
                      && (!request.resource.data.keys().contains('isVerified') || request.resource.data.isVerified == false);
                      
        // Prevent ordinary users from tampering with isVerified on update
        allow update: if request.auth != null && request.auth.uid == uid 
                      && (!request.resource.data.keys().contains('isVerified') || request.resource.data.isVerified == resource.data.isVerified);
                      
        // Founder / admin override
        allow write: if hasPermission('users') || isFounder();

        match /watch_history/{historyId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read: if hasPermission('auditoria');
      allow create: if request.auth != null; // Auditing action
      allow update, delete: if isFounder();
    }

    // Community Messages rules
    match /community_messages/{messageId} {
      allow read: if true; // anyone can read public messages
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && (!request.resource.data.keys().contains('isVerified') || request.resource.data.isVerified == false || isFounder());
      allow update: if isFounder() || hasPermission('users'); // moderation
      allow delete: if isFounder() || hasPermission('users');
    }

    // Community Moderation rules (Bans, Mutes)
    match /community_moderation/{document=**} {
      allow read: if true; // anyone can check their ban/mute status
      allow write: if isFounder() || hasPermission('users');
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
