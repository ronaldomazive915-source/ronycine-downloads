rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isFounder() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'ronaldomazive915@gmail.com') ||
        (request.auth.token.get('role', '') == 'FOUNDER') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'FOUNDER' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email.lower() == 'ronaldomazive915@gmail.com'
        ))
      );
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // --- PUBLIC COLLECTIONS (Catalog, Media & Configurations) ---
    
    match /catalog/{docId} {
      allow read, write: if true;
    }
    match /catalog_metadata/{docId} {
      allow read, write: if true;
    }
    match /deleted_catalog/{docId} {
      allow read, write: if true;
    }
    match /playerSources/{docId} {
      allow read, write: if true;
    }
    match /playerConfig/{docId} {
      allow read, write: if true;
    }
    match /media/{docId} {
      allow read, write: if true;
    }
    match /episodes/{docId} {
      allow read, write: if true;
    }
    match /live_channels/{docId} {
      allow read, write: if true;
    }
    match /channels/{docId} {
      allow read, write: if true;
    }
    match /events/{docId} {
      allow read, write: if true;
    }
    match /featured/{docId} {
      allow read, write: if true;
    }
    match /config/{docId} {
      allow read, write: if true;
    }
    match /settings/{docId} {
      allow read, write: if true;
    }
    match /system/{docId} {
      allow read, write: if true;
    }
    match /appUpdates/{docId} {
      allow read, write: if true;
    }
    match /notifications/{docId} {
      allow read, write: if true;
    }
    match /notificationEvents/{docId} {
      allow read, write: if true;
    }
    
    match /import_jobs/{docId} { allow read, write: if true; }
    match /import_items/{docId} { allow read, write: if true; }
    match /media_requests/{docId} { allow read, write: if true; }

    match /usernames/{docId} { allow read: if true; allow write: if isAuthenticated(); }
    match /community_messages/{docId} { allow read: if true; allow write: if isAuthenticated(); }
    match /community_moderation/{docId} { allow read: if true; allow write: if isFounder(); }

    // --- PROTECTED COLLECTIONS ---

    match /devices {
      allow list, get: if isFounder();
      allow write: if true; 
    }
    match /devices/{deviceId} {
      allow get: if true; // Allow anyone to check if their device exists
      allow read: if isFounder() || (isAuthenticated() && resource != null && resource.data.uid == request.auth.uid);
      allow write: if true;
    }

    match /users {
      allow list, get: if isFounder();
    }
    match /users/{uid} {
      allow get: if isOwner(uid) || isFounder();
      allow list: if isFounder();
      allow write: if isOwner(uid) || isFounder();
      
      match /{allSubpaths=**} {
        allow read, write: if isOwner(uid) || isFounder();
      }
    }

    // --- COLLECTION GROUPS ---
    match /{path=**}/profiles {
      allow list: if isAuthenticated();
    }
    match /{path=**}/profiles/{profileId} {
      allow get, list: if isAuthenticated() && (
        isFounder() || 
        (path.size() >= 2 && path[1] == request.auth.uid)
      );
      allow write: if isFounder() || (isAuthenticated() && path.size() >= 2 && path[1] == request.auth.uid);
    }
    
    match /{path=**}/watch_history {
      allow list: if isAuthenticated();
    }
    match /{path=**}/watch_history/{historyId} {
      allow read, write: if isAuthenticated() && (
        isFounder() || 
        (path.size() >= 2 && path[1] == request.auth.uid)
      );
    }

    // --- ADMIN & LOGS ---
    match /audit_logs/{document=**} { allow read, write: if isFounder(); }
    match /adminAuditLogs/{document=**} { allow read, write: if isFounder(); }
    match /admin_settings/{document=**} { allow read, write: if isFounder(); }

    // --- DEFAULT DENY ---
    match /{document=**} {
      allow read, write: if isFounder();
    }
  }
}
